<Window x:Class="TcpClientApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="TCP Client" Height="400" Width="500">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="AddressBox" Width="150" Text="localhost"/>
            <TextBox x:Name="PortBox" Width="80" Margin="10,0" Text="5000"/>
            <Button Content="Connect" Click="Connect_Click"/>
        </StackPanel>

        <TextBox x:Name="ChatBox" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBox x:Name="MessageBox" Width="300"/>
            <Button Content="Send" Click="Send_Click" Margin="10,0"/>
        </StackPanel>
    </Grid>
</Window>
